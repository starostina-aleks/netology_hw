# --- Основные настройки сервиса ---
SUPPORT_SERVICE_NAME=CloudBox
SUPPORT_LOG_PATH=assistant.log
LANGUAGE=ru

OPENAI_API_KEY = 
OPENROUTER_API_KEY = 

# --- Тайм-ауты и повторные попытки (Tenacity) ---
SUPPORT_TIMEOUT_SECONDS=30.0
SUPPORT_RETRY_ATTEMPTS=3

# --- Лимиты истории и Redis кэш ---
SUPPORT_HISTORY_LIMIT=10
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600